# Copy to .env.local and fill in. Never commit real values.

# Contact form delivery (app/contact/actions.ts) through Resend.
# Without these in development, inquiries are logged to the terminal instead of emailed.
# In production both are required, or the form shows a "could not be sent" error.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=

# Optional. The sender for inquiry emails; must use a domain verified in Resend.
# Defaults to "Moirel Studio <onboarding@resend.dev>".
INQUIRY_FROM_EMAIL=

# Optional. The client workspace sign-in address. When set, a "Client login" link
# appears in the header.
NEXT_PUBLIC_CLIENT_LOGIN_URL=
